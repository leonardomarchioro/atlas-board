// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String  @map("password_hash")
  avatarUrl    String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  createdBoards Board[]          @relation("BoardCreatedBy")
  boardMembers  BoardMember[]
  assignedTasks Task[]           @relation("TaskAssignee")
  createdTasks  Task[]           @relation("TaskCreatedBy")
  sharedTasks   TaskSharedUser[]
  taskComments  TaskComment[]

  @@map("users")
}

enum BoardRole {
  ADMIN
  COLLABORATOR
}

enum BoardMemberStatus {
  PENDING
  ACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Board {
  id          String  @id @default(uuid())
  name        String
  description String?
  createdById String  @map("created_by_id")

  createdBy User          @relation("BoardCreatedBy", fields: [createdById], references: [id])
  members   BoardMember[]
  columns   BoardColumn[]
  tasks     Task[]
  tags      Tag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("boards")
}

model BoardMember {
  id      String  @id @default(uuid())
  boardId String  @map("board_id")
  userId  String? @map("user_id")
  email   String

  role   BoardRole         @default(COLLABORATOR)
  status BoardMemberStatus @default(PENDING)

  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  acceptedAt      DateTime? @map("accepted_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([boardId, email])
  @@index([boardId])
  @@index([userId])
  @@index([status])
  @@map("board_members")
}

model Task {
  id          String       @id @default(uuid())
  boardId     String       @map("board_id")
  columnId    String       @map("column_id")
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  position    Int
  dueDate     DateTime?    @map("due_date")
  assigneeId  String?      @map("assignee_id")
  createdById String       @map("created_by_id")

  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column    BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee  User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User        @relation("TaskCreatedBy", fields: [createdById], references: [id])

  sharedWith     TaskSharedUser[]
  tags           TaskTag[]
  checklistItems TaskChecklistItem[]
  comments       TaskComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([columnId, position])
  @@index([boardId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id       String @id @default(uuid())
  taskId   String @map("task_id")
  authorId String @map("author_id")
  content  String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@index([authorId])
  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskSharedUser {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  userId String @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_shared_users")
}

model Tag {
  id      String @id @default(uuid())
  boardId String @map("board_id")
  name    String
  color   String

  board Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([boardId, name])
  @@index([boardId])
  @@map("tags")
}

model TaskTag {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model TaskChecklistItem {
  id          String  @id @default(uuid())
  taskId      String  @map("task_id")
  title       String
  isCompleted Boolean @default(false) @map("is_completed")
  position    Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([taskId, position])
  @@index([taskId])
  @@map("task_checklist_items")
}

model BoardColumn {
  id       String @id @default(uuid())
  boardId  String @map("board_id")
  name     String
  position Int

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([boardId, position])
  @@index([boardId])
  @@map("board_columns")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  jti       String    @unique
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
